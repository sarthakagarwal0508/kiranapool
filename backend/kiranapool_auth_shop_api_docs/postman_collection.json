{
  "info": {
    "name": "KiranaPool \u2014 Auth + Shops",
    "description": "Import with the KiranaPool Local environment. Signup/login stores token automatically. Google auth requires a real Google ID token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (use a new email)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/signup",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Shopkeeper\",\n  \"email\": \"shopkeeper1@example.com\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"shopkeeper\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  " const b = pm.response.json();",
                  " if (b.token) pm.environment.set('token', b.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shopkeeper1@example.com\",\n  \"password\": \"TestPass123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  " const b = pm.response.json();",
                  " if (b.token) pm.environment.set('token', b.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Google Auth (real ID token required)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/google",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\",\n  \"role\": \"shopkeeper\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Current user (/me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Shops",
      "item": [
        {
          "name": "Create shop",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/shops",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sharma Kirana\",\n  \"ownerName\": \"Amit Sharma\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Malviya Nagar, Jaipur\",\n  \"location\": {\n    \"lat\": 26.854,\n    \"lng\": 75.824\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  " const b = pm.response.json();",
                  " if (b.data && b.data._id) pm.environment.set('shopId', b.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List shops",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/shops"
          }
        },
        {
          "name": "Get shop by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/shops/{{shopId}}"
          }
        },
        {
          "name": "Update shop",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/shops/{{shopId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sharma Kirana Store\"\n}"
            }
          }
        },
        {
          "name": "Delete shop (destructive)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/shops/{{shopId}}"
          }
        }
      ]
    }
  ]
}