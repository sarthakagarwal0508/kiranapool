# Required
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=12h

# Frontend / browser session security
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
AUTH_COOKIE_NAME=kp_access
CSRF_COOKIE_NAME=kp_csrf
TRUST_PROXY=false

# Privileged role registration: use strong, separate invitation codes.
# Leave unset to disable public wholesaler/rider account creation.
WHOLESALER_SIGNUP_INVITE_CODE=
RIDER_SIGNUP_INVITE_CODE=

# Demo seeding is disabled unless explicitly enabled. Use a unique strong password.
ALLOW_DEMO_SEED=false
ALLOW_DEMO_SEED_IN_PRODUCTION=false
DEMO_SEED_PASSWORD=

# Optional Google sign-in
GOOGLE_CLIENT_ID=

# Optional FastAPI ML integration
ML_SERVICE_URL=https://kiranapool-05x4.onrender.com
ML_SERVICE_TIMEOUT_MS=20000
ML_ROUTE_TIMEOUT_MS=20000
ML_FALLBACK_ENABLED=true
ML_ROUTE_INTEGRATION_ENABLED=true
ML_SERVICE_TOKEN=

# Optional warehouse serviceability fallback radius
WAREHOUSE_MAX_DELIVERY_DISTANCE_KM=25
