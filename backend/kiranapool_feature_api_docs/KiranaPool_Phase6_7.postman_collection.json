          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create delivery plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/plans",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"<WAREHOUSE_OBJECT_ID>\",\n  \"orderIds\": [\n    \"<ORDER_OBJECT_ID>\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List delivery plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/plans?page=1&limit=50"
      }
    },
    {
      "name": "Assign rider",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/plans/<PLAN_OBJECT_ID>/assign-rider",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"riderId\": \"<RIDER_OBJECT_ID>\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Unassign rider before route starts",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/plans/<PLAN_OBJECT_ID>/assign-rider"
      }
    },
    {
      "name": "Run forecasts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/forecasts/run",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"horizonDays\": 7,\n  \"groupBy\": \"both\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}