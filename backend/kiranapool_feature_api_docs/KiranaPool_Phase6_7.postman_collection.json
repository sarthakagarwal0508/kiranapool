{
  "info": {
    "_postman_id": "b8c8045c-24c5-4ee4-92ae-9e62e870d4e8",
    "name": "KiranaPool Phase 6-7 Backend APIs",
    "description": "Run seed:demo first. Logins save role tokens; use requests in order. The collection sets tomorrow 10:00\u201312:00 IST as a reusable delivery slot. Base API: http://localhost:5000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const offset = 330 * 60 * 1000;",
          "const indiaNow = new Date(Date.now() + offset);",
          "const tomorrowLocalMidnight = Date.UTC(indiaNow.getUTCFullYear(), indiaNow.getUTCMonth(), indiaNow.getUTCDate() + 1);",
          "const start = new Date(tomorrowLocalMidnight + 10 * 60 * 60 * 1000 - offset);",
          "const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
          "pm.collectionVariables.set(\"slotStart\", start.toISOString());",
          "pm.collectionVariables.set(\"slotEnd\", end.toISOString());"
        ]
      }
    }
  ],
